<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenTalk.App"
             xmlns:local="using:OpenTalk"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <!-- Dark theme (hand-tuned) -->
                <ResourceDictionary x:Key="Dark">
                    <!-- Surfaces -->
                    <Color x:Key="OT.WindowBgColor">#1D1F24</Color>
                    <Color x:Key="OT.SidebarBgColor">#202329</Color>
                    <Color x:Key="OT.RightPanelBgColor">#FFFFFF</Color>
                    <Color x:Key="OT.ListPaneBgColor">#2A2E36</Color>
                    <Color x:Key="OT.TopbarBgColor">#F5F5F5</Color>
                    <Color x:Key="OT.ChatAreaBgColor">#EDEDED</Color>
                    <Color x:Key="OT.InputBarBgColor">#F7F7F7</Color>

                    <!-- Borders -->
                    <Color x:Key="OT.BorderColor">#D9D9D9</Color>
                    <Color x:Key="OT.BorderStrongColor">#BFC3C9</Color>

                    <!-- Text -->
                    <Color x:Key="OT.TextColor">#1F1F1F</Color>
                    <Color x:Key="OT.TextMutedColor">#70757F</Color>
                    <Color x:Key="OT.TextSubtleColor">#8A8F99</Color>
                    <Color x:Key="OT.AccentTextColor">#07C160</Color>

                    <!-- Buttons -->
                    <Color x:Key="OT.ButtonBgColor">#07C160</Color>
                    <Color x:Key="OT.ButtonBorderColor">#07C160</Color>
                    <Color x:Key="OT.GhostBorderColor">#C6CAD1</Color>
                    <Color x:Key="OT.GhostTextColor">#4C525C</Color>

                    <!-- Cards / items -->
                    <Color x:Key="OT.CardBgColor">#323741</Color>
                    <Color x:Key="OT.CardBorderColor">#323741</Color>
                    <Color x:Key="OT.CardHoverBgColor">#3C424D</Color>
                    <Color x:Key="OT.CardSelectedBgColor">#3C424D</Color>
                    <Color x:Key="OT.CardSelectedBorderColor">#07C160</Color>

                    <!-- Bubbles -->
                    <Color x:Key="OT.SelfBubbleBgColor">#95EC69</Color>
                    <Color x:Key="OT.OtherBubbleBgColor">#FFFFFF</Color>
                    <Color x:Key="OT.OtherBubbleBorderColor">#DFDFDF</Color>

                    <!-- Inputs -->
                    <Color x:Key="OT.InputBgColor">#FFFFFF</Color>
                    <Color x:Key="OT.InputBorderColor">#D6D6D6</Color>
                    <Color x:Key="OT.InputBorderHoverColor">#C9CDD4</Color>
                    <Color x:Key="OT.InputBorderFocusColor">#07C160</Color>
                    <Color x:Key="OT.SelectionBgColor">#07C160</Color>
                    <Color x:Key="OT.AvatarBgColor">#07C160</Color>
                </ResourceDictionary>

                <!-- Light theme (hand-tuned, new) -->
                <ResourceDictionary x:Key="Light">
                    <!-- Surfaces: warm paper + cool ink -->
                    <Color x:Key="OT.WindowBgColor">#FFFFFF</Color>
                    <Color x:Key="OT.SidebarBgColor">#2E3238</Color>
                    <Color x:Key="OT.RightPanelBgColor">#FFFFFF</Color>
                    <Color x:Key="OT.ListPaneBgColor">#F5F5F5</Color>
                    <Color x:Key="OT.TopbarBgColor">#F8F8F8</Color>
                    <Color x:Key="OT.ChatAreaBgColor">#EDEDED</Color>
                    <Color x:Key="OT.InputBarBgColor">#F7F7F7</Color>

                    <!-- Borders: soft graphite -->
                    <Color x:Key="OT.BorderColor">#D9D9D9</Color>
                    <Color x:Key="OT.BorderStrongColor">#C8CCD3</Color>

                    <!-- Text: deep ink -->
                    <Color x:Key="OT.TextColor">#1F1F1F</Color>
                    <Color x:Key="OT.TextMutedColor">#70757F</Color>
                    <Color x:Key="OT.TextSubtleColor">#8A8F99</Color>
                    <Color x:Key="OT.AccentTextColor">#07C160</Color>

                    <!-- Buttons: ink on mist -->
                    <Color x:Key="OT.ButtonBgColor">#07C160</Color>
                    <Color x:Key="OT.ButtonBorderColor">#07C160</Color>
                    <Color x:Key="OT.GhostBorderColor">#C8CCD3</Color>
                    <Color x:Key="OT.GhostTextColor">#4C525C</Color>

                    <!-- Cards / items -->
                    <Color x:Key="OT.CardBgColor">#FFFFFF</Color>
                    <Color x:Key="OT.CardBorderColor">#E4E6EA</Color>
                    <Color x:Key="OT.CardHoverBgColor">#F1F3F5</Color>
                    <Color x:Key="OT.CardSelectedBgColor">#ECF8F1</Color>
                    <Color x:Key="OT.CardSelectedBorderColor">#07C160</Color>

                    <!-- Bubbles -->
                    <Color x:Key="OT.SelfBubbleBgColor">#95EC69</Color>
                    <Color x:Key="OT.OtherBubbleBgColor">#FFFFFF</Color>
                    <Color x:Key="OT.OtherBubbleBorderColor">#DFDFDF</Color>

                    <!-- Inputs -->
                    <Color x:Key="OT.InputBgColor">#FFFFFF</Color>
                    <Color x:Key="OT.InputBorderColor">#D6D6D6</Color>
                    <Color x:Key="OT.InputBorderHoverColor">#C9CDD4</Color>
                    <Color x:Key="OT.InputBorderFocusColor">#07C160</Color>
                    <Color x:Key="OT.SelectionBgColor">#07C160</Color>
                    <Color x:Key="OT.AvatarBgColor">#07C160</Color>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Brushes mapped from colors above -->
            <SolidColorBrush x:Key="OT.WindowBgBrush" Color="{DynamicResource OT.WindowBgColor}"/>
            <SolidColorBrush x:Key="OT.SidebarBgBrush" Color="{DynamicResource OT.SidebarBgColor}"/>
            <SolidColorBrush x:Key="OT.RightPanelBgBrush" Color="{DynamicResource OT.RightPanelBgColor}"/>
            <SolidColorBrush x:Key="OT.ListPaneBgBrush" Color="{DynamicResource OT.ListPaneBgColor}"/>
            <SolidColorBrush x:Key="OT.TopbarBgBrush" Color="{DynamicResource OT.TopbarBgColor}"/>
            <SolidColorBrush x:Key="OT.ChatAreaBgBrush" Color="{DynamicResource OT.ChatAreaBgColor}"/>
            <SolidColorBrush x:Key="OT.InputBarBgBrush" Color="{DynamicResource OT.InputBarBgColor}"/>

            <SolidColorBrush x:Key="OT.BorderBrush" Color="{DynamicResource OT.BorderColor}"/>
            <SolidColorBrush x:Key="OT.BorderStrongBrush" Color="{DynamicResource OT.BorderStrongColor}"/>

            <SolidColorBrush x:Key="OT.TextBrush" Color="{DynamicResource OT.TextColor}"/>
            <SolidColorBrush x:Key="OT.TextMutedBrush" Color="{DynamicResource OT.TextMutedColor}"/>
            <SolidColorBrush x:Key="OT.TextSubtleBrush" Color="{DynamicResource OT.TextSubtleColor}"/>
            <SolidColorBrush x:Key="OT.AccentTextBrush" Color="{DynamicResource OT.AccentTextColor}"/>

            <SolidColorBrush x:Key="OT.ButtonBgBrush" Color="{DynamicResource OT.ButtonBgColor}"/>
            <SolidColorBrush x:Key="OT.ButtonBorderBrush" Color="{DynamicResource OT.ButtonBorderColor}"/>
            <SolidColorBrush x:Key="OT.GhostBorderBrush" Color="{DynamicResource OT.GhostBorderColor}"/>
            <SolidColorBrush x:Key="OT.GhostTextBrush" Color="{DynamicResource OT.GhostTextColor}"/>

            <SolidColorBrush x:Key="OT.CardBgBrush" Color="{DynamicResource OT.CardBgColor}"/>
            <SolidColorBrush x:Key="OT.CardBorderBrush" Color="{DynamicResource OT.CardBorderColor}"/>
            <SolidColorBrush x:Key="OT.CardHoverBgBrush" Color="{DynamicResource OT.CardHoverBgColor}"/>
            <SolidColorBrush x:Key="OT.CardSelectedBgBrush" Color="{DynamicResource OT.CardSelectedBgColor}"/>
            <SolidColorBrush x:Key="OT.CardSelectedBorderBrush" Color="{DynamicResource OT.CardSelectedBorderColor}"/>

            <SolidColorBrush x:Key="OT.SelfBubbleBgBrush" Color="{DynamicResource OT.SelfBubbleBgColor}"/>
            <SolidColorBrush x:Key="OT.OtherBubbleBgBrush" Color="{DynamicResource OT.OtherBubbleBgColor}"/>
            <SolidColorBrush x:Key="OT.OtherBubbleBorderBrush" Color="{DynamicResource OT.OtherBubbleBorderColor}"/>

            <SolidColorBrush x:Key="OT.InputBgBrush" Color="{DynamicResource OT.InputBgColor}"/>
            <SolidColorBrush x:Key="OT.InputBorderBrush" Color="{DynamicResource OT.InputBorderColor}"/>
            <SolidColorBrush x:Key="OT.InputBorderHoverBrush" Color="{DynamicResource OT.InputBorderHoverColor}"/>
            <SolidColorBrush x:Key="OT.InputBorderFocusBrush" Color="{DynamicResource OT.InputBorderFocusColor}"/>
            <SolidColorBrush x:Key="OT.SelectionBrush" Color="{DynamicResource OT.SelectionBgColor}"/>
            <SolidColorBrush x:Key="OT.AvatarBgBrush" Color="{DynamicResource OT.AvatarBgColor}"/>
        </ResourceDictionary>
    </Application.Resources>
  
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
