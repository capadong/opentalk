<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenTalk.ViewModels"
        xmlns:model="using:OpenTalk.Models"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        x:Name="RootWindow"
        x:Class="OpenTalk.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="1360"
        Height="820"
        MinWidth="1080"
        MinHeight="720"
        Background="#0B1020"
        Foreground="#E5E7EB"
        Icon="/Assets/avalonia-logo.ico"
        Title="OpenTalk">

    <Window.Styles>
        <Style Selector="TextBlock.heading">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style Selector="Button.panelAction">
            <Setter Property="Background" Value="#18213A"/>
            <Setter Property="BorderBrush" Value="#253052"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
        <Style Selector="Button.memberAction">
            <Setter Property="Background" Value="#121A2E"/>
            <Setter Property="BorderBrush" Value="#22304D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#E5E7EB"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        </Style>
        <Style Selector="Button.memberAction:pointerover">
            <Setter Property="Background" Value="#1A2540"/>
        </Style>
        <Style Selector="Border.selfBubble">
            <Setter Property="Background" Value="#2D6DF6"/>
            <Setter Property="CornerRadius" Value="18,18,6,18"/>
        </Style>
        <Style Selector="Border.otherBubble">
            <Setter Property="Background" Value="#141C31"/>
            <Setter Property="CornerRadius" Value="18,18,18,6"/>
            <Setter Property="BorderBrush" Value="#24314F"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="280,*,250" RowDefinitions="Auto,*,Auto">
        <Border Grid.RowSpan="3" Background="#0F172A" BorderBrush="#1E293B" BorderThickness="0,0,1,0" Padding="18">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Spacing="10">
                    <TextBlock Classes="heading" Text="OpenTalk"/>
                    <TextBlock Foreground="#94A3B8" Text="Avalonia Client · 群聊 / 私聊"/>
                    <Border Background="#131D34" BorderBrush="#253052" BorderThickness="1" CornerRadius="14" Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="12" Foreground="#8FA1C7" Text="连接状态"/>
                            <TextBlock FontSize="16" FontWeight="Bold" Text="{Binding ConnectionState}"/>
                            <TextBlock FontSize="11" Foreground="#7C8DB5" Text="{Binding StatusText}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                    <Button Classes="panelAction" Command="{Binding RefreshCommand}">刷新群组</Button>
                </StackPanel>

                <StackPanel Margin="0,18,0,0" Spacing="10">
                    <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#8FA1C7" Text="我的群组"/>
                    <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}" Background="Transparent" BorderThickness="0">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="model:ChatGroup">
                                <Border Margin="0,0,0,8" Padding="14,12" CornerRadius="14" Background="#121A2E" BorderBrush="#22304D" BorderThickness="1">
                                    <StackPanel Spacing="4">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}"/>
                                        <TextBlock FontSize="11" Foreground="#7C8DB5" Text="{Binding Id, StringFormat='ID: {0}'}"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Background="#0B1020" BorderBrush="#1E293B" BorderThickness="0,0,0,1" Padding="22,18">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="4">
                    <TextBlock FontSize="24" FontWeight="Bold" Text="{Binding CurrentTitle}"/>
                    <TextBlock Foreground="#8B9ABA" Text="{Binding CurrentSubtitle}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right">
                    <Border Background="#11192D" BorderBrush="#233150" BorderThickness="1" CornerRadius="999" Padding="12,6" HorizontalAlignment="Right">
                        <TextBlock FontSize="12" Foreground="#BFDBFE" Text="{Binding CurrentUserLabel}"/>
                    </Border>
                    <Button Classes="panelAction" Command="{Binding OpenGroupChatCommand}" IsVisible="{Binding IsDirectMode}">返回群聊</Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Grid.Column="1" Background="#0A0F1D">
            <ScrollViewer Margin="0" Padding="22,18">
                <ItemsControl ItemsSource="{Binding Messages}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ChatMessageItemViewModel">
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" HorizontalAlignment="Left" MaxWidth="520" Spacing="5" IsVisible="{Binding IsOther}">
                                    <TextBlock FontSize="12" Foreground="#94A3B8" Text="{Binding SenderName}"/>
                                    <Border Classes="otherBubble" Padding="14,10">
                                        <TextBlock TextWrapping="Wrap" Text="{Binding Content}"/>
                                    </Border>
                                    <TextBlock FontSize="11" Foreground="#64748B" Text="{Binding TimeText}"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" HorizontalAlignment="Right" MaxWidth="520" Spacing="5" IsVisible="{Binding IsSelf}">
                                    <TextBlock FontSize="12" Foreground="#93C5FD" HorizontalAlignment="Right" Text="{Binding SenderName}"/>
                                    <Border Classes="selfBubble" Padding="14,10">
                                        <TextBlock TextWrapping="Wrap" Text="{Binding Content}"/>
                                    </Border>
                                    <TextBlock FontSize="11" Foreground="#64748B" HorizontalAlignment="Right" Text="{Binding TimeText}"/>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Grid.Column="1" Background="#0D1426" BorderBrush="#1E293B" BorderThickness="0,1,0,0" Padding="18">
            <StackPanel Spacing="12">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" FontSize="12" Foreground="#7C8DB5" Text="{Binding InputHint}"/>
                    <Button DockPanel.Dock="Right" Classes="panelAction" Command="{Binding LoadMoreCommand}" IsEnabled="{Binding CanLoadMore}">加载历史</Button>
                </DockPanel>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBox Name="MessageInput"
                             KeyDown="MessageInput_OnKeyDown"
                             Grid.Column="0"
                             Text="{Binding MessageText, Mode=TwoWay}"
                             Watermark="输入消息..."
                             AcceptsReturn="True"
                             MinHeight="84"
                             TextWrapping="Wrap"/>
                    <Button Grid.Column="1"
                            Classes="panelAction"
                            Command="{Binding SendCommand}"
                            IsEnabled="{Binding CanSend}"
                            MinWidth="100"
                            VerticalAlignment="Bottom">
                        发送
                    </Button>
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.RowSpan="3" Grid.Column="2" Background="#0E1628" BorderBrush="#1E293B" BorderThickness="1,0,0,0" Padding="18">
            <StackPanel Spacing="12">
                <TextBlock Classes="heading" Text="成员"/>
                <TextBlock Foreground="#8FA1C7" Text="点击成员可打开私聊"/>
                <ItemsControl ItemsSource="{Binding Members}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="model:GroupMember">
                            <Button Classes="memberAction"
                                    Command="{Binding #RootWindow.DataContext.OpenDirectChatCommand}"
                                    CommandParameter="{Binding}">
                                <Border Padding="12" Background="Transparent">
                                    <StackPanel Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                                        <TextBlock FontSize="11" Foreground="#7C8DB5" Text="{Binding Username, StringFormat='@{0}'}"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
