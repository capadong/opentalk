<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:model="using:OpenTalk.Models"
             x:Class="OpenTalk.Views.Components.MemberChip"
             x:DataType="model:GroupMember">
    <Border Padding="10,6" Background="Transparent">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="wxAvatarCircle" Width="30" Height="30">
                <TextBlock Classes="wxAvatarText" FontSize="12" Text="👤"/>
            </Border>
            <StackPanel VerticalAlignment="Center" Spacing="0">
                <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding DisplayName}"/>
                <TextBlock Classes="wxConversationMeta" Text="{Binding Username, StringFormat='@{0}'}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
