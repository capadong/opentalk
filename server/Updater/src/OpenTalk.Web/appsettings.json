{
  "App": {
    "SelfUrl": "https://localhost:44326",
    "HealthCheckUrl": "/health-status"
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": ["FromLogContext"],
    "WriteTo": [
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "File",
              "Args": {
                "path": "Logs/logs.txt"
              }
            }
          ]
        }
      },
      {
        "Name": "Async",
        "Args": {
          "configure": [
            {
              "Name": "Console"
            }
          ]
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Default": "Server=localhost;Port=3306;Database=OpenTalk;Uid=root;Pwd=myPassword;"
  },
  "AuthServer": {
    "Authority": "https://localhost:44326",
    "RequireHttpsMetadata": true,
    "CertificatePassPhrase": "14b7165b-acdb-44fa-a68d-222d701eae76"
  },
  "StringEncryption": {
    "DefaultPassPhrase": "Lpw5i0ABHxak9ZL8"
  }
}
