@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Authorization
@using System.Security.Claims
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@(ViewData["Title"] ?? "OpenTalk Admin")</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
  <style>
    body { padding-top: 4.5rem; }
  </style>
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-dark fixed-top">
    <div class="container-fluid">
      <a class="navbar-brand" href="/Admin">OpenTalk Admin</a>
      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
        <span class="navbar-toggler-icon"></span>
      </button>
      <div class="collapse navbar-collapse" id="navbarNav">
        <ul class="navbar-nav me-auto">
          <li class="nav-item"><a class="nav-link" href="/Admin">首页</a></li>
          <li class="nav-item"><a class="nav-link" href="/Admin/Users">Users</a></li>
          <li class="nav-item"><a class="nav-link" href="/Admin/Groups">Groups</a></li>
          <li class="nav-item"><a class="nav-link" href="/Admin/Files">文件管理</a></li>
          <li class="nav-item"><a class="nav-link" href="/swagger">Swagger</a></li>
        </ul>
        <ul class="navbar-nav">
          @if (User?.Identity?.IsAuthenticated ?? false)
          {
            <li class="nav-item"><span class="navbar-text me-3">管理员: @User.Identity!.Name</span></li>
            <li class="nav-item"><a class="btn btn-outline-light btn-sm" href="/Admin/Logout">退出</a></li>
          }
          else
          {
            <li class="nav-item"><a class="btn btn-outline-light btn-sm" href="/Admin/Login">登录</a></li>
          }
        </ul>
      </div>
    </div>
  </nav>
  <main class="container">
    @RenderBody()
  </main>
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
