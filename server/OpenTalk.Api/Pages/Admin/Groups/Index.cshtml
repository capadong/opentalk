@page
@model OpenTalk.Pages.Admin.Groups.IndexModel
@{
  ViewData["Title"] = "群组管理";
}
<script>
  async function delGroup(id){ if(confirm('删除该群组？')){ await fetch(`?handler=DeleteGroup&id=${id}`,{method:'POST'}); location.reload(); } }
  async function addMember(gid){ const uid=prompt('用户ID'); if(!uid) return; await fetch(`?handler=AddMember&gid=${gid}&uid=${uid}`,{method:'POST'}); location.reload(); }
  async function removeMember(gid,uid){ if(confirm('移除该成员？')){ await fetch(`?handler=RemoveMember&gid=${gid}&uid=${uid}`,{method:'POST'}); location.reload(); } }
</script>
<div class="py-3">
  <div class="card mb-3">
    <div class="card-body">
      <h5 class="card-title">新建群组</h5>
      <form method="post" class="row g-3">
        <div class="col-md-5">
          <input class="form-control" name="Name" placeholder="群组名称" required />
        </div>
        <div class="col-md-5">
          <input class="form-control" name="OwnerId" type="number" placeholder="Owner 用户ID" required />
        </div>
        <div class="col-md-2 d-grid">
          <button class="btn btn-primary" type="submit">创建</button>
        </div>
      </form>
    </div>
  </div>
  <div class="card">
    <div class="card-body">
      <h5 class="card-title">群组列表</h5>
      <div class="table-responsive">
      <table class="table table-striped align-middle">
        <thead><tr><th>Id</th><th>Name</th><th>Owner</th><th>Created</th><th>Members</th><th>操作</th></tr></thead>
        <tbody>
        @foreach (var g in Model.Groups)
        {
          <tr>
            <td>@g.Id</td>
            <td>@g.Name</td>
            <td>@g.OwnerId</td>
            <td>@g.CreatedAt</td>
            <td>
              @if (Model.Members.TryGetValue(g.Id, out var ms))
              {
                @foreach (var m in ms)
                {
                  <span class="badge text-bg-secondary me-1">
                    @m.UserId
                    <button class="btn btn-sm btn-link text-light p-0 ms-1" onclick="removeMember(@g.Id,@m.UserId)">×</button>
                  </span>
                }
              }
            </td>
            <td>
              <div class="btn-group btn-group-sm">
                <button type="button" class="btn btn-outline-primary" onclick="addMember(@g.Id)">添加成员</button>
                <button type="button" class="btn btn-outline-danger" onclick="delGroup(@g.Id)">删除</button>
              </div>
            </td>
          </tr>
        }
        </tbody>
      </table>
      </div>
    </div>
  </div>
</div>
