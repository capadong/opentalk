@page
@model OpenTalk.Pages.Admin.DashboardModel
@{
    ViewData["Title"] = "Dashboard";
}
<div class="py-4">
  <div class="row g-3">
    <div class="col-md-3">
      <div class="card text-bg-primary mb-3 shadow-sm">
        <div class="card-body">
          <div class="card-title fs-5">在线连接</div>
          <div class="display-6">@Model.OnlineConnections</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-bg-success mb-3 shadow-sm">
        <div class="card-body">
          <div class="card-title fs-5">今日消息</div>
          <div class="display-6">@Model.TodayMessages</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-bg-secondary mb-3 shadow-sm">
        <div class="card-body">
          <div class="card-title fs-5">用户总数</div>
          <div class="display-6">@Model.UserCount</div>
        </div>
      </div>
    </div>
    <div class="col-md-3">
      <div class="card text-bg-warning mb-3 shadow-sm">
        <div class="card-body">
          <div class="card-title fs-5">群组总数</div>
          <div class="display-6">@Model.GroupCount</div>
        </div>
      </div>
    </div>
  </div>
  <div class="card shadow-sm">
    <div class="card-body">
      <h5 class="card-title mb-3">快捷入口</h5>
      <a class="btn btn-outline-primary me-2" href="/Admin/Users">用户管理</a>
      <a class="btn btn-outline-primary me-2" href="/Admin/Groups">群组管理</a>
      <a class="btn btn-outline-secondary me-2" href="/Admin/Files">文件管理</a>
      <a class="btn btn-outline-secondary" href="/swagger">Swagger</a>
    </div>
  </div>
</div>
