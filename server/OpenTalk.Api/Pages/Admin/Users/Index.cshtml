@page
@model OpenTalk.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "用户管理";
}
<script>
    function csrf(){ const el = document.querySelector('input[name="__RequestVerificationToken"]'); return el ? el.value : ''; }
    async function del(id){
      if(!confirm('删除该用户？')) return;
      await fetch(`?handler=Delete&id=${id}`,{ method:'POST', headers: { 'RequestVerificationToken': csrf() }});
      location.reload();
    }
</script>
<div class="py-3">
  <div class="d-flex justify-content-end mb-3">
    <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createUserModal">新建用户</button>
  </div>
  <div class="modal fade" id="createUserModal" tabindex="-1" aria-labelledby="createUserModalLabel" aria-hidden="true">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title" id="createUserModalLabel">新建用户</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
        </div>
        <form method="post">
          @Html.AntiForgeryToken()
          <div class="modal-body">
            <div class="mb-3">
              <label class="form-label">用户名</label>
              <input class="form-control" name="Username" required />
            </div>
            <div class="mb-3">
              <label class="form-label">密码</label>
              <input class="form-control" name="Password" type="password" required />
            </div>
            <div class="mb-3">
              <label class="form-label">昵称</label>
              <input class="form-control" name="Nickname" />
            </div>
          </div>
          <div class="modal-footer">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">取消</button>
            <button type="submit" class="btn btn-primary">创建</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <div class="card">
    <div class="card-body">
      <h5 class="card-title">用户列表</h5>
      <div class="table-responsive">
      <table class="table table-striped">
        <thead><tr><th>Id</th><th>Username</th><th>Nickname</th><th>Created</th><th>操作</th></tr></thead>
        <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Username</td>
                <td>@u.Nickname</td>
                <td>@u.CreatedAt</td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="del(@u.Id)">删除</button></td>
            </tr>
        }
        </tbody>
      </table>
      </div>
    </div>
  </div>
</div>
