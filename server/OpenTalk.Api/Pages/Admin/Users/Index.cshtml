@page
@model OpenTalk.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "用户管理";
}
<script>
    async function del(id){ if(confirm('删除该用户？')){ await fetch(`?handler=Delete&id=${id}`,{method:'POST'}); location.reload(); } }
</script>
<div class="py-3">
  <div class="card mb-3">
    <div class="card-body">
      <h5 class="card-title">新建用户</h5>
      <form method="post" class="row g-3">
        <div class="col-md-4">
          <input class="form-control" name="Username" placeholder="用户名" required />
        </div>
        <div class="col-md-4">
          <input class="form-control" name="Password" type="password" placeholder="密码" required />
        </div>
        <div class="col-md-3">
          <input class="form-control" name="Nickname" placeholder="昵称" />
        </div>
        <div class="col-md-1 d-grid">
          <button class="btn btn-primary" type="submit">创建</button>
        </div>
      </form>
    </div>
  </div>
  <div class="card">
    <div class="card-body">
      <h5 class="card-title">用户列表</h5>
      <div class="table-responsive">
      <table class="table table-striped">
        <thead><tr><th>Id</th><th>Username</th><th>Nickname</th><th>Created</th><th>操作</th></tr></thead>
        <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>@u.Id</td>
                <td>@u.Username</td>
                <td>@u.Nickname</td>
                <td>@u.CreatedAt</td>
                <td><button type="button" class="btn btn-sm btn-outline-danger" onclick="del(@u.Id)">删除</button></td>
            </tr>
        }
        </tbody>
      </table>
      </div>
    </div>
  </div>
</div>
